MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/careerguid?retryWrites=true&w=majority
JWT_SECRET=generate-your-own-random-secret-here
PORT=3001
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxx
# Shared AI key used for every user's AI requests (get a free key at console.groq.com)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
# Used to score IELTS pretest essays (Writing Task 2). Free key at https://aistudio.google.com/apikey
# Optional — without it the pretest still works using only the objective quiz score.
GEMINI_API_KEY=
# College Scorecard (US university data: tuition, admission rate, SAT). Free key: https://api.data.gov/signup/
SCORECARD_API_KEY=
